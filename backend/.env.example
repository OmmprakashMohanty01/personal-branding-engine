# App Settings
ENV=development
PROJECT_NAME="AI Personal Branding Engine"

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./branding_engine.db

# LLM Settings
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=gemini,openai

# API Keys
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Discovery API Credentials
NEWS_API_KEY=your_news_api_key
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT="ai-personal-branding:v1.0"
PRODUCT_HUNT_DEVELOPER_TOKEN=your_product_hunt_token

# Cryptographic token encryption key (AES-256 Fernet)
ENCRYPTION_KEY=your_fernet_encryption_key

# Social Integrations Client Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret

THREADS_CLIENT_ID=your_threads_client_id
THREADS_CLIENT_SECRET=your_threads_client_secret

# SMTP Server Configurations (Required for Substack Email-to-Publish)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_sending_email_address@gmail.com
SMTP_PASSWORD=your_sending_email_password

# Scheduling Webhook Security Secret
API_CRON_SECRET=your_super_secret_string_here

# Monitoring & Alerts Settings (Discord or Slack)
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# ALERT_PROVIDER=discord
